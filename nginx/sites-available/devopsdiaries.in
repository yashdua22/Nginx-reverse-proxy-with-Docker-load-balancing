# ─────────────────────────────────────────────────────────
# UPSTREAM — backend servers ka group
# ─────────────────────────────────────────────────────────
upstream backend_pool {
    # least_conn = jis backend pe sabse kam active connections hain
    # usko next request milegi. Round-robin se behtar jab response
    # times alag-alag hote hain.
    least_conn;

    # max_fails=3      → 3 baar fail hua to backend ko down maan lo
    # fail_timeout=30s → 30 second tak usko requests mat bhejo
    server 127.0.0.1:3001 max_fails=3 fail_timeout=30s;
    server 127.0.0.1:3002 max_fails=3 fail_timeout=30s;

    # Backend ke saath connections reuse karo — har request pe naya
    # TCP handshake nahi. Latency kaafi kam ho jaati hai.
    keepalive 32;
}

# ─────────────────────────────────────────────────────────
# HTTP → HTTPS REDIRECT
# ─────────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name devopsdiaries.in www.devopsdiaries.in;

    # Certbot ko renewal ke waqt is path ki zarurat padti hai
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─────────────────────────────────────────────────────────
# www → non-www REDIRECT
# ─────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.devopsdiaries.in;

    ssl_certificate     /etc/letsencrypt/live/devopsdiaries.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devopsdiaries.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://devopsdiaries.in$request_uri;
}

# ─────────────────────────────────────────────────────────
# MAIN HTTPS SERVER
# ─────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name devopsdiaries.in;

    # ── SSL ──
    ssl_certificate     /etc/letsencrypt/live/devopsdiaries.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devopsdiaries.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # ── LOGGING ──
    access_log /var/log/nginx/devopsdiaries.in.access.log detailed;
    error_log  /var/log/nginx/devopsdiaries.in.error.log warn;

    # ── SECURITY HEADERS ──
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ── CONNECTION LIMIT ──
    # Ek IP se max 20 simultaneous connections
    limit_conn addr 20;

    # ── ERROR PAGES ──
    error_page 502 /502.html;
    error_page 503 504 /50x.html;
    error_page 429 /429.html;

    location = /502.html {
        root /usr/share/nginx/errors;
        internal;
    }
    location = /50x.html {
        root /usr/share/nginx/errors;
        internal;
    }
    location = /429.html {
        root /usr/share/nginx/errors;
        internal;
    }

    # ── HEALTH CHECK — log mat karo, rate limit mat lagao ──
    location = /health {
        proxy_pass http://backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        access_log off;
    }

    # ── STATIC ASSETS — lambi cache ──
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        proxy_pass http://backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 30d;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }

    # ── API ROUTES — strict rate limit, no cache ──
    location /api/ {
        limit_req zone=api burst=10 nodelay;

        proxy_pass http://backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        # Ek backend fail ho to doosre pe retry
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;

        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # ── MAIN CATCH-ALL ROUTE ──
    location / {
        # burst=20 → short spike mein 20 extra requests allow
        # nodelay  → queue mein rakhne ke bajaye turant serve
        limit_req zone=general burst=20 nodelay;

        proxy_pass http://backend_pool;
        proxy_http_version 1.1;

        # Backend ko batao asli request kahan se aayi
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        # WebSocket support
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Timeouts
        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size       8k;
        proxy_buffers           8 8k;
        proxy_busy_buffers_size 16k;

        # Failover
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 10s;
    }

    # ── Hidden files block karo (.git, .env etc) ──
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}